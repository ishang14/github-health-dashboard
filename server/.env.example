# GitHub personal access token (classic or fine-grained, public repo read access)
GITHUB_TOKEN=

# MongoDB connection string
MONGODB_URI=

# Server port (optional, defaults to 5000)
PORT=5000

# Comma-separated list of allowed browser origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens - use a long random string
JWT_SECRET=
# Token lifetime (optional, e.g. 1d, 7d, 12h)
JWT_EXPIRES_IN=7d

# Minutes before an unchanged repo earns another health-trend point
# (default 60; set 0 to record every analysis)
SNAPSHOT_INTERVAL_MINUTES=60
